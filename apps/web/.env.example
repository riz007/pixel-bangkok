# Public URL of the deployed site (no trailing slash): canonical links, sitemap, llms.txt, OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of published map assets (manifests, tiles, POIs, thumbnails). Defaults to /maps.
# For production, point this at object storage, e.g. https://maps.example.com
NEXT_PUBLIC_MAP_ASSETS_URL=/maps

# Name shown as "Made by …" in the About dialog. Leave empty to hide the line.
NEXT_PUBLIC_MAKER_NAME=

# Public source repository linked from the About dialog. Leave empty to hide the link.
NEXT_PUBLIC_REPO_URL=https://github.com/riz007/pixel-bangkok

# Google Tag Manager container ID (GTM-XXXXXXX). Leave empty to load no analytics.
NEXT_PUBLIC_GTM_ID=
